{
  "name": "personal-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal work assistant engine for Claude Code with an Obsidian vault as memory.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "pai": "bin/pai"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "node --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pai": "node src/cli.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
